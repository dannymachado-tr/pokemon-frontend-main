{
  "name": "pokemon-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false --runInBand",
    "eject": "react-scripts eject",
    "docker:build": "docker build -f codeCake/Dockerfile -t pokemon-frontend .",
    "docker:run": "npm run deploy",
    "lint": "eslint src --ext .js --max-warnings=0",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "deploy": "sh codeCake/deploy.sh",
    "test:watch": "react-scripts test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:3001",
  "devDependencies": {
    "@testing-library/react": "14.3.1",
    "eslint": "8.57.1"
  }
}
